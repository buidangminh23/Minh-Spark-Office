{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minh Spark Office",
  "version": "0.2.65",
  "identifier": "com.minhspark.office",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build && node scripts/prepare-desktop.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net/pyodide/v314.0.7/full/; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://cdn.jsdelivr.net/pyodide/v314.0.7/full/ ipc: http://ipc.localhost https://ipc.localhost data: blob: https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://firebaseinstallations.googleapis.com https://office.minhspark.com https://api.anthropic.com https://api.openai.com https://commons.wikimedia.org https://upload.wikimedia.org https://thumb.wikimedia.org; worker-src 'self' blob:; frame-src 'self' blob: https://www.youtube-nocookie.com https://www.youtube.com https://player.vimeo.com; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczMzkwQ0RFMTAxMzVGM0UKUldRK1h4TVEzZ3c1YzlSNUFvS3hvalBZeFhzNjlzeTh1OVpvZUFPeEZjOVZ0VG0xQTlveXY4U0EK",
      "endpoints": [
        "https://office.minhspark.com/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "resources": {
      "icons/icon.ico": "office-app.ico"
    },
    "publisher": "Minh Spark",
    "category": "Productivity",
    "shortDescription": "Documents, spreadsheets and PDF in one workspace",
    "copyright": "Copyright © 2026 Minh Spark",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "languages": [
          "Vietnamese"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "startMenuFolder": "Minh Spark Office",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh",
        "sidebarImage": "windows/sidebar.bmp",
        "headerImage": "windows/header.bmp"
      },
      "wix": {
        "fragmentPaths": [
          "windows/file-associations.wxs"
        ],
        "componentRefs": [
          "MinhSparkFileAssociations"
        ],
        "language": "en-US",
        "upgradeCode": "D6A780C5-E410-42E8-A263-A27DC3F63C70",
        "bannerPath": "windows/wix-banner.bmp",
        "dialogImagePath": "windows/wix-dialog.bmp"
      }
    }
  }
}
