{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minh Spark Office",
  "version": "0.1.0",
  "identifier": "com.minhspark.office",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost data: blob:; worker-src 'self' blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Minh Spark",
    "category": "Productivity",
    "shortDescription": "Documents, spreadsheets and PDF in one workspace",
    "copyright": "Copyright © 2026 Minh Spark",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "languages": ["Vietnamese"],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "startMenuFolder": "Minh Spark Office",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "windows/sidebar.bmp",
        "headerImage": "windows/header.bmp"
      },
      "wix": {
        "language": "en-US",
        "upgradeCode": "D6A780C5-E410-42E8-A263-A27DC3F63C70",
        "bannerPath": "windows/wix-banner.bmp",
        "dialogImagePath": "windows/wix-dialog.bmp"
      }
    }
  }
}
