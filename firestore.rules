rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function safeNumber(value) {
      return value is number && value >= 0 && value <= 9007199254740991;
    }
    function validRevision(value) {
      return value is string && value.matches('^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$');
    }
    function validMeta(meta, id) {
      return meta is map
        && meta.keys().hasAll(['id', 'name', 'kind', 'createdAt', 'updatedAt', 'openedAt', 'starred', 'deletedAt', 'size', 'preview'])
        && meta.keys().hasOnly(['id', 'name', 'kind', 'createdAt', 'updatedAt', 'openedAt', 'starred', 'deletedAt', 'size', 'preview'])
        && meta.id == id && meta.name is string && meta.name.size() <= 1024
        && meta.kind in ['doc', 'sheet', 'pdf', 'slide', 'image']
        && safeNumber(meta.createdAt) && safeNumber(meta.updatedAt) && safeNumber(meta.openedAt) && safeNumber(meta.size)
        && meta.starred is bool && (meta.deletedAt == null || safeNumber(meta.deletedAt))
        && meta.preview is string && meta.preview.size() <= 8000;
    }
    function validManifest(data, id) {
      return id.matches('^[A-Za-z0-9_-]{1,160}$')
        && data.keys().hasAll(['schema', 'revision', 'deleted', 'meta', 'chunkCount', 'encoding', 'compressedBytes', 'uncompressedBytes', 'sha256', 'updatedAt'])
        && data.keys().hasOnly(['schema', 'revision', 'deleted', 'meta', 'chunkCount', 'encoding', 'compressedBytes', 'uncompressedBytes', 'sha256', 'updatedAt'])
        && data.schema in [1, 2] && validRevision(data.revision) && data.deleted is bool
        && data.encoding == 'gzip-base64' && data.updatedAt == request.time
        && data.chunkCount is int && data.chunkCount >= 0 && data.chunkCount <= (data.schema == 1 ? 14 : 600)
        && data.compressedBytes is int && data.uncompressedBytes is int && data.sha256 is string
        && ((data.deleted && data.meta == null && data.chunkCount == 0 && data.compressedBytes == 0 && data.uncompressedBytes == 0 && data.sha256 == '')
          || (!data.deleted && validMeta(data.meta, id) && data.chunkCount >= 1
            && data.compressedBytes >= 1 && data.compressedBytes <= (data.schema == 1 ? 6291456 : 268435456)
            && data.compressedBytes > (data.chunkCount - 1) * 450000 && data.compressedBytes <= data.chunkCount * 450000
            && data.uncompressedBytes >= 1 && data.uncompressedBytes <= (data.schema == 1 ? 33554432 : 536870912)
            && data.sha256.matches('^[a-f0-9]{64}$')));
    }
    function usageDay() {
      return int((request.time.toMillis() + 25200000) / 86400000);
    }
    function validUsage(data) {
      return data.keys().hasAll(['day', 'count']) && data.keys().hasOnly(['day', 'count'])
        && data.day is int && data.day == usageDay() && data.count is int;
    }
    match /aiUsage/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validUsage(request.resource.data) && request.resource.data.count == 1;
      allow update: if owner(uid) && validUsage(request.resource.data)
        && ((resource.data.day == usageDay() && request.resource.data.count == resource.data.count + 1)
          || (resource.data.day != usageDay() && request.resource.data.count == 1));
      allow delete: if false;
    }
    function desktopLoginId(id) {
      return id.matches('^[A-Za-z0-9_-]{43}$');
    }
    function validDesktopLogin(data) {
      return data.keys().hasAll(['ephemeralKey', 'iv', 'ciphertext', 'createdAt', 'expireAt'])
        && data.keys().hasOnly(['ephemeralKey', 'iv', 'ciphertext', 'createdAt', 'expireAt'])
        && data.ephemeralKey is string && data.ephemeralKey.matches('^B[A-Za-z0-9_-]{86}$')
        && data.iv is string && data.iv.matches('^[A-Za-z0-9_-]{16}$')
        && data.ciphertext is string && data.ciphertext.size() >= 32 && data.ciphertext.size() <= 8192
        && data.ciphertext.matches('^[A-Za-z0-9_-]+$')
        && data.createdAt == request.time
        && data.expireAt is timestamp && data.expireAt > request.time && data.expireAt <= request.time + duration.value(15, 'm');
    }
    match /desktopLogins/{id} {
      allow get: if desktopLoginId(id);
      allow list: if false;
      allow create: if request.auth != null && desktopLoginId(id) && validDesktopLogin(request.resource.data);
      allow update: if false;
      allow delete: if desktopLoginId(id);
    }
    function publicCounter(counter) {
      return counter in ['downloadsWindows', 'downloadsMac', 'users'];
    }
    match /publicStats/{counter} {
      allow read: if publicCounter(counter);
      allow create: if publicCounter(counter) && request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == 1;
      allow update: if publicCounter(counter) && request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }
    function signedIn() {
      return request.auth != null;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function verifiedEmail() {
      return signedIn() && request.auth.token.email is string && request.auth.token.email_verified == true;
    }
    function roleRank(role) {
      return role == 'owner' ? 4 : (role == 'admin' ? 3 : (role == 'editor' ? 2 : (role == 'viewer' ? 1 : 0)));
    }
    function teamDoc(teamId) {
      return /databases/$(database)/documents/teams/$(teamId);
    }
    function memberDoc(teamId, uid) {
      return /databases/$(database)/documents/teams/$(teamId)/members/$(uid);
    }
    function inviteDoc(teamId, inviteId) {
      return /databases/$(database)/documents/teams/$(teamId)/invites/$(inviteId);
    }
    function itemDoc(teamId, itemId) {
      return /databases/$(database)/documents/teams/$(teamId)/items/$(itemId);
    }
    function isMember(teamId) {
      return signedIn() && exists(memberDoc(teamId, request.auth.uid));
    }
    function myRank(teamId) {
      return isMember(teamId) ? roleRank(get(memberDoc(teamId, request.auth.uid)).data.role) : 0;
    }
    function shortText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }
    function validTeam(data) {
      return data.keys().hasAll(['name', 'description', 'color', 'ownerUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'description', 'color', 'ownerUid', 'createdAt', 'updatedAt'])
        && shortText(data.name, 1, 80) && data.name.matches('.*[^ ].*') && shortText(data.description, 0, 500)
        && data.color is string && data.color.matches('^#[0-9a-f]{6}$')
        && data.ownerUid is string && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    function validMember(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'name', 'photoURL', 'role', 'joinedAt', 'inviteId'])
        && data.keys().hasOnly(['uid', 'email', 'name', 'photoURL', 'role', 'joinedAt', 'inviteId'])
        && data.uid == uid && shortText(data.email, 0, 320) && shortText(data.name, 0, 120) && shortText(data.photoURL, 0, 2048)
        && data.role in ['owner', 'admin', 'editor', 'viewer'] && data.joinedAt is timestamp && shortText(data.inviteId, 0, 40);
    }
    function validInvite(teamId, data) {
      return data.keys().hasAll(['email', 'role', 'invitedBy', 'invitedByName', 'teamName', 'createdAt', 'expireAt'])
        && data.keys().hasOnly(['email', 'role', 'invitedBy', 'invitedByName', 'teamName', 'createdAt', 'expireAt'])
        && shortText(data.email, 3, 254) && data.email.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+[.][a-z]{2,}$')
        && data.role in ['admin', 'editor', 'viewer'] && data.invitedBy == request.auth.uid && shortText(data.invitedByName, 0, 120)
        && data.teamName == get(teamDoc(teamId)).data.name && data.createdAt == request.time
        && data.expireAt is timestamp && data.expireAt > request.time && data.expireAt <= request.time + duration.value(7, 'd');
    }
    function validItem(data) {
      return data.keys().hasAll(['type', 'name', 'kind', 'description', 'category', 'authorUid', 'authorName', 'createdAt', 'updatedAt', 'updatedBy', 'updatedByName', 'revision', 'chunkCount', 'compressedBytes', 'uncompressedBytes', 'sha256', 'preview', 'size'])
        && data.keys().hasOnly(['type', 'name', 'kind', 'description', 'category', 'authorUid', 'authorName', 'createdAt', 'updatedAt', 'updatedBy', 'updatedByName', 'revision', 'chunkCount', 'compressedBytes', 'uncompressedBytes', 'sha256', 'preview', 'size'])
        && data.type in ['template', 'document'] && data.kind in ['doc', 'sheet', 'slide']
        && shortText(data.name, 1, 200) && shortText(data.description, 0, 1000) && shortText(data.category, 0, 60)
        && data.authorUid is string && shortText(data.authorName, 0, 120) && data.createdAt is timestamp
        && data.updatedAt == request.time && data.updatedBy == request.auth.uid && shortText(data.updatedByName, 0, 120)
        && validRevision(data.revision) && data.chunkCount is int && data.chunkCount >= 1 && data.chunkCount <= 60
        && data.compressedBytes is int && data.compressedBytes >= 1 && data.compressedBytes <= data.chunkCount * 450000
        && data.compressedBytes > (data.chunkCount - 1) * 450000
        && data.uncompressedBytes is int && data.uncompressedBytes >= 1 && data.uncompressedBytes <= 134217728
        && data.sha256 is string && data.sha256.matches('^[a-f0-9]{64}$') && shortText(data.preview, 0, 2000) && safeNumber(data.size);
    }
    function sameStoredPayload(after, before) {
      return after.revision == before.revision && after.chunkCount == before.chunkCount && after.compressedBytes == before.compressedBytes
        && after.uncompressedBytes == before.uncompressedBytes && after.sha256 == before.sha256;
    }
    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /{path=**}/invites/{inviteId} {
      allow read: if verifiedEmail() && resource.data.email == myEmail();
    }
    match /teams/{teamId} {
      allow read: if isMember(teamId);
      allow create: if signedIn() && teamId.matches('^[A-Za-z0-9_-]{20}$') && validTeam(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid && request.resource.data.createdAt == request.time
        && existsAfter(memberDoc(teamId, request.auth.uid)) && getAfter(memberDoc(teamId, request.auth.uid)).data.role == 'owner';
      allow update: if myRank(teamId) == 4 && validTeam(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.ownerUid == resource.data.ownerUid
          || (exists(memberDoc(teamId, request.resource.data.ownerUid))
            && getAfter(memberDoc(teamId, request.resource.data.ownerUid)).data.role == 'owner'
            && getAfter(memberDoc(teamId, request.auth.uid)).data.role == 'admin'));
      allow delete: if myRank(teamId) == 4;

      match /members/{uid} {
        allow read: if isMember(teamId);
        allow create: if signedIn() && uid == request.auth.uid && validMember(request.resource.data, uid) && request.resource.data.joinedAt == request.time
          && ((request.resource.data.role == 'owner' && request.resource.data.inviteId == '' && !exists(teamDoc(teamId))
              && existsAfter(teamDoc(teamId)) && getAfter(teamDoc(teamId)).data.ownerUid == uid)
            || (verifiedEmail() && request.resource.data.email == myEmail() && request.resource.data.inviteId.matches('^[A-Za-z0-9_-]{24}$')
              && exists(inviteDoc(teamId, request.resource.data.inviteId))
              && get(inviteDoc(teamId, request.resource.data.inviteId)).data.email == myEmail()
              && get(inviteDoc(teamId, request.resource.data.inviteId)).data.expireAt > request.time
              && get(inviteDoc(teamId, request.resource.data.inviteId)).data.role == request.resource.data.role
              && !existsAfter(inviteDoc(teamId, request.resource.data.inviteId))));
        allow update: if validMember(request.resource.data, uid) && (
          (uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoURL']))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) && (
            (uid != request.auth.uid && myRank(teamId) >= 3 && roleRank(resource.data.role) < myRank(teamId)
              && request.resource.data.role != 'owner' && roleRank(request.resource.data.role) < myRank(teamId))
            || (myRank(teamId) == 4 && uid != request.auth.uid && request.resource.data.role == 'owner'
              && getAfter(teamDoc(teamId)).data.ownerUid == uid)
            || (myRank(teamId) == 4 && uid == request.auth.uid && request.resource.data.role == 'admin'
              && getAfter(teamDoc(teamId)).data.ownerUid != uid
              && getAfter(memberDoc(teamId, getAfter(teamDoc(teamId)).data.ownerUid)).data.role == 'owner'))));
        allow delete: if signedIn() && (
          (uid == request.auth.uid && (resource.data.role != 'owner' || !exists(teamDoc(teamId))))
          || (uid != request.auth.uid && myRank(teamId) >= 3 && roleRank(resource.data.role) < myRank(teamId)));
      }

      match /invites/{inviteId} {
        allow read: if isMember(teamId) || (verifiedEmail() && resource.data.email == myEmail());
        allow create: if inviteId.matches('^[A-Za-z0-9_-]{24}$') && myRank(teamId) >= 3
          && roleRank(request.resource.data.role) < myRank(teamId) && validInvite(teamId, request.resource.data);
        allow update: if false;
        allow delete: if myRank(teamId) >= 3 || (verifiedEmail() && resource.data.email == myEmail());
      }

      match /items/{itemId} {
        allow read: if isMember(teamId);
        allow create: if itemId.matches('^[A-Za-z0-9_-]{20}$') && myRank(teamId) >= 2 && validItem(request.resource.data)
          && request.resource.data.authorUid == request.auth.uid && request.resource.data.createdAt == request.time;
        allow update: if myRank(teamId) >= 2 && validItem(request.resource.data)
          && request.resource.data.authorUid == resource.data.authorUid && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.type == resource.data.type && request.resource.data.kind == resource.data.kind
          && (resource.data.type == 'document' || resource.data.authorUid == request.auth.uid || myRank(teamId) >= 3)
          && (request.resource.data.revision != resource.data.revision || sameStoredPayload(request.resource.data, resource.data));
        allow delete: if (myRank(teamId) >= 2 && resource.data.authorUid == request.auth.uid) || myRank(teamId) >= 3;

        match /chunks/{chunkId} {
          function chunkRevision() {
            return chunkId.split('_')[0];
          }
          function notLiveRevision() {
            return !exists(itemDoc(teamId, itemId)) || get(itemDoc(teamId, itemId)).data.revision != chunkRevision();
          }
          allow read: if isMember(teamId);
          allow create: if myRank(teamId) >= 2
            && chunkId.matches('^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}_([0-9]|[1-5][0-9])$')
            && request.resource.data.keys().hasAll(['revision', 'index', 'data']) && request.resource.data.keys().hasOnly(['revision', 'index', 'data'])
            && request.resource.data.revision == chunkRevision() && request.resource.data.index is int
            && chunkId == request.resource.data.revision + '_' + string(request.resource.data.index)
            && request.resource.data.data is string && request.resource.data.data.size() > 0 && request.resource.data.data.size() <= 600000
            && request.resource.data.data.matches('^[A-Za-z0-9+/]*={0,2}$') && notLiveRevision();
          allow update: if false;
          allow delete: if myRank(teamId) >= 2 && notLiveRevision();
        }

        function liveDocument() {
          return exists(itemDoc(teamId, itemId)) && get(itemDoc(teamId, itemId)).data.type == 'document';
        }

        match /peers/{peerId} {
          allow read: if isMember(teamId);
          allow create, update: if isMember(teamId) && liveDocument() && peerId.matches('^[A-Za-z0-9]{1,128}_[A-Za-z0-9_-]{10}$')
            && peerId.split('_')[0] == request.auth.uid
            && request.resource.data.keys().hasAll(['peerId', 'uid', 'name', 'photoURL', 'color', 'role', 'at'])
            && request.resource.data.keys().hasOnly(['peerId', 'uid', 'name', 'photoURL', 'color', 'role', 'at'])
            && request.resource.data.peerId == peerId && request.resource.data.uid == request.auth.uid
            && shortText(request.resource.data.name, 0, 120) && shortText(request.resource.data.photoURL, 0, 2048)
            && request.resource.data.color is string && request.resource.data.color.matches('^#[0-9a-f]{6}$')
            && request.resource.data.role == get(memberDoc(teamId, request.auth.uid)).data.role
            && request.resource.data.at == request.time;
          allow delete: if isMember(teamId);
        }

        match /signals/{signalId} {
          allow read: if isMember(teamId);
          allow create: if isMember(teamId) && liveDocument() && signalId.matches('^[A-Za-z0-9_-]{20}$')
            && request.resource.data.keys().hasAll(['from', 'fromUid', 'to', 'kind', 'sdp', 'at'])
            && request.resource.data.keys().hasOnly(['from', 'fromUid', 'to', 'kind', 'sdp', 'at'])
            && request.resource.data.fromUid == request.auth.uid && request.resource.data.from is string
            && request.resource.data.from.split('_')[0] == request.auth.uid && shortText(request.resource.data.to, 1, 160)
            && request.resource.data.kind in ['offer', 'answer'] && shortText(request.resource.data.sdp, 1, 60000)
            && request.resource.data.at == request.time;
          allow update: if false;
          allow delete: if isMember(teamId);
        }

        match /live/{name} {
          allow read: if isMember(teamId);
          allow create, update: if myRank(teamId) >= 2 && liveDocument() && (
            (name == 'lock' && request.resource.data.keys().hasOnly(['peerId', 'uid', 'at']) && request.resource.data.uid == request.auth.uid
              && request.resource.data.at == request.time)
            || (name == 'head' && request.resource.data.keys().hasAll(['revision', 'chunkCount', 'bytes', 'updatedBy', 'updatedByUid', 'updatedByName', 'at'])
              && request.resource.data.keys().hasOnly(['revision', 'chunkCount', 'bytes', 'updatedBy', 'updatedByUid', 'updatedByName', 'at'])
              && validRevision(request.resource.data.revision) && request.resource.data.chunkCount is int
              && request.resource.data.chunkCount >= 1 && request.resource.data.chunkCount <= 60
              && request.resource.data.bytes is int && request.resource.data.updatedByUid == request.auth.uid
              && shortText(request.resource.data.updatedByName, 0, 120) && request.resource.data.at == request.time));
          allow delete: if myRank(teamId) >= 3 || (myRank(teamId) >= 2 && !exists(itemDoc(teamId, itemId)));
        }

        match /liveChunks/{chunkId} {
          function liveRevision() {
            return chunkId.split('_')[0];
          }
          function liveHead() {
            return /databases/$(database)/documents/teams/$(teamId)/items/$(itemId)/live/head;
          }
          allow read: if isMember(teamId);
          allow create: if myRank(teamId) >= 2 && liveDocument()
            && chunkId.matches('^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}_([0-9]|[1-5][0-9])$')
            && request.resource.data.keys().hasAll(['revision', 'index', 'data']) && request.resource.data.keys().hasOnly(['revision', 'index', 'data'])
            && request.resource.data.revision == liveRevision() && request.resource.data.index is int
            && chunkId == request.resource.data.revision + '_' + string(request.resource.data.index)
            && request.resource.data.data is string && request.resource.data.data.size() <= 600000
            && (!exists(liveHead()) || get(liveHead()).data.revision != liveRevision());
          allow update: if false;
          allow delete: if myRank(teamId) >= 2 && (!exists(liveHead()) || get(liveHead()).data.revision != liveRevision());
        }
      }
    }
    match /users/{uid}/files/{fileId} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validManifest(request.resource.data, fileId);
      allow update: if owner(uid) && validManifest(request.resource.data, fileId) && request.resource.data.revision != resource.data.revision;
      allow delete: if false;
      match /chunks/{chunkId} {
        function parentPath() {
          return /databases/$(database)/documents/users/$(uid)/files/$(fileId);
        }
        function parentChanged() {
          return existsAfter(parentPath()) && (!exists(parentPath()) || getAfter(parentPath()).data.revision != get(parentPath()).data.revision);
        }
        function validChunk() {
          let data = request.resource.data;
          let parent = getAfter(parentPath()).data;
          return data.keys().hasAll(['revision', 'index', 'data']) && data.keys().hasOnly(['revision', 'index', 'data'])
            && data.index is int && data.index >= 0 && data.index < 14 && chunkId == string(data.index)
            && parent.schema == 1 && !parent.deleted && data.index < parent.chunkCount && data.revision == parent.revision
            && data.data is string && data.data.size() > 0 && data.data.size() <= 600000
            && data.data.size() == (data.index < parent.chunkCount - 1 ? 600000 : int((parent.compressedBytes + 2) / 3) * 4 - data.index * 600000)
            && data.data.matches('^[A-Za-z0-9+/]*={0,2}$');
        }
        function legacyChunk() {
          return chunkId.matches('^([0-9]|1[0-3])$');
        }
        function revisionChunk() {
          return chunkId.matches('^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}_([0-9]|[1-9][0-9]|[1-5][0-9][0-9])$');
        }
        function notCurrentRevision(revision) {
          return !exists(parentPath()) || get(parentPath()).data.revision != revision;
        }
        function validRevisionChunk() {
          let data = request.resource.data;
          return fileId.matches('^[A-Za-z0-9_-]{1,160}$')
            && data.keys().hasAll(['revision', 'index', 'data']) && data.keys().hasOnly(['revision', 'index', 'data'])
            && validRevision(data.revision) && data.index is int && data.index >= 0 && data.index < 600
            && chunkId == data.revision + '_' + string(data.index)
            && data.data is string && data.data.size() > 0 && data.data.size() <= 600000 && data.data.size() % 4 == 0
            && data.data.matches('^[A-Za-z0-9+/]*={0,2}$')
            && notCurrentRevision(data.revision);
        }
        allow read: if owner(uid);
        allow create: if owner(uid) && ((legacyChunk() && parentChanged() && validChunk()) || (revisionChunk() && validRevisionChunk()));
        allow update: if owner(uid) && legacyChunk() && parentChanged() && validChunk();
        allow delete: if owner(uid) && ((legacyChunk() && parentChanged()
          && (getAfter(parentPath()).data.deleted || getAfter(parentPath()).data.schema == 2 || int(chunkId) >= getAfter(parentPath()).data.chunkCount))
          || (revisionChunk() && notCurrentRevision(chunkId.split('_')[0])));
      }
    }
  }
}
