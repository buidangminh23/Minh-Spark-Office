{
  "name": "minh-spark-office",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "r2_buckets": [
    { "binding": "LARGE_FILES", "bucket_name": "minh-spark-office-files" }
  ],
  "observability": { "enabled": true }
}
